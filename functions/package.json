{
  "name": "functions",
  "description": "Cloud Functions for CAGF - Reconnaissance faciale des présences",
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "download-models": "node scripts/download-models.js",
    "postinstall": "node scripts/download-models.js",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "canvas": "^2.11.2",
    "face-api.js": "^0.22.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "private": true
}
